{
  "name": "qrcode-toolkit-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 and SvelteKit component for qrcode-toolkit: zero-dependency QR codes that render on the server and in the browser.",
  "keywords": [
    "qrcode",
    "qr-code",
    "qrcode-generator",
    "svelte",
    "svelte5",
    "sveltekit",
    "ssr",
    "svg",
    "typescript",
    "qrcode-toolkit"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/qrcode-toolkit.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/githubthinnd/qrcode-toolkit/issues"
  },
  "homepage": "https://github.com/githubthinnd/qrcode-toolkit/tree/master/packages/svelte#readme",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
