{
  "name": "qrcode-toolkit",
  "version": "0.1.0",
  "description": "Zero-dependency QR code generator for JavaScript and TypeScript: SVG, PNG, Kanji, ECI, GS1 and structured append. Works in Node.js, browsers, React, Next.js, Vue, Nuxt, Svelte, Angular and Astro.",
  "keywords": [
    "qrcode",
    "qr-code",
    "qr",
    "qrcode-generator",
    "qr-code-generator",
    "qr-code-library",
    "qrcode-toolkit",
    "typescript",
    "esm",
    "zero-dependency",
    "svg",
    "png",
    "canvas",
    "isomorphic",
    "universal",
    "ssr",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "svelte",
    "sveltekit",
    "angular",
    "astro",
    "nodejs",
    "kanji",
    "gs1",
    "eci",
    "structured-append",
    "toolkit"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/qrcode-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/githubthinnd/qrcode-toolkit/issues"
  },
  "homepage": "https://github.com/githubthinnd/qrcode-toolkit#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./kanji": {
      "types": "./dist/kanji.d.ts",
      "default": "./dist/kanji.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.universal.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run arch && npm run test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run check",
    "playground": "npm run playground:build && node playground/serve.mjs",
    "playground:build": "npm run build && node scripts/build-playground.mjs",
    "playground:serve": "node playground/serve.mjs",
    "check:name": "node scripts/check-name.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@zxing/library": "^0.23.0",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsqr": "^1.4.0",
    "lean-qr": "^2.7.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "qr": "^0.7.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "uqr": "^0.1.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
