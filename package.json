{
  "name": "qrcode-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Universal, extensible, framework-agnostic QR Code toolkit for JavaScript and TypeScript.",
  "keywords": [
    "qrcode",
    "qr-code",
    "qr",
    "typescript",
    "svg",
    "png",
    "universal",
    "toolkit"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/qrcode-kit.git"
  },
  "bugs": {
    "url": "https://github.com/githubthinnd/qrcode-kit/issues"
  },
  "homepage": "https://github.com/githubthinnd/qrcode-kit#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.universal.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run arch && npm run test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@zxing/library": "^0.23.0",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsqr": "^1.4.0",
    "lean-qr": "^2.7.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "qr": "^0.7.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "uqr": "^0.1.3",
    "vitest": "^5.1.0"
  }
}
